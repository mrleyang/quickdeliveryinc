<%- include('partials/header') %>

<section class="auth-section">
  <div class="container auth-layout">
    <div class="auth-panel info-panel">
      <p class="eyebrow">Join QuickDeveleryInc</p>
      <h1>Get started in just a few moments</h1>
      <p>Manage deliveries quickly and reliably, whether you are shipping for yourself or your business.</p>
      <ul class="feature-list compact-list">
        <li>Simple, secure shipping</li>
        <li>Optimized tracking</li>
        <li>Centralized management</li>
      </ul>
      <div class="transport-gallery register-transport-gallery" role="region" aria-roledescription="carousel" aria-label="Parcel, air and sea delivery" tabindex="0">
        <div class="transport-track">
          <figure class="transport-card">
            <img src="/images/parcel-photo.jpg" alt="Packages moving through a shipping warehouse" />
            <figcaption>Parcels</figcaption>
          </figure>
          <figure class="transport-card">
            <img src="/images/aircraft-photo.jpg" alt="Cathay Pacific cargo airplane at the airport" />
            <figcaption>Air</figcaption>
          </figure>
          <figure class="transport-card">
            <img src="/images/cargo-ship-photo.jpg" alt="Container ship carrying freight at port" />
            <figcaption>Sea</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <div class="auth-panel auth-box">
      <h2>Create an account</h2>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/register" class="auth-form">
        <label>
          Full name
          <input type="text" name="name" placeholder="Alex Morgan" required />
        </label>

        <label>
          Email address
          <input type="email" name="email" placeholder="you@example.com" required />
        </label>

        <label>
          Password
          <input type="password" name="password" placeholder="At least 6 characters" required />
        </label>

        <button type="submit" class="btn btn-primary full-width">Create my account</button>
      </form>

      <p class="auth-link">Already have an account? <a href="/login">Sign in</a></p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
