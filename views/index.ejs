<%- include('partials/header') %>

<section class="hero">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">Smarter delivery</p>
      <h1>Logistics that move your business forward.</h1>
      <p class="lead">
        QuickDeveleryInc brings shipments, customers and logistics teams together in one seamless platform.
      </p>

      <form class="tracking-form" action="/track" method="GET">
        <input type="text" name="q" placeholder="Enter a tracking number" aria-label="Tracking number" />
        <button class="btn btn-primary" type="submit">Track</button>
      </form>

      <div class="cta-row">
        <a class="btn btn-primary" href="/register">Create account</a>
        <a class="btn btn-secondary" href="/login">Sign in</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="card-floating package-card">
        <span class="mini-label">Shipment in transit</span>
        <strong>QD-240001</strong>
        <small>Paris → Lyon</small>
      </div>
      <div class="delivery-animation" role="img" aria-label="A parcel travels from a warehouse to a home">
        <svg viewBox="0 0 360 150" aria-hidden="true">
          <path class="delivery-route" d="M 322 112 Q 180 8 38 112" />
          <path class="delivery-horizon" d="M 18 116 H 342" />
          <g class="home-icon" transform="translate(8 82)">
            <path class="home-roof" d="M 0 15 28 0 56 15 52 20 28 7 4 20Z" />
            <path class="home-wall" d="M 7 18 28 7 49 18V 34H 7Z" />
            <path class="home-door" d="M 23 23H 33V 34H 23Z" />
            <path class="home-window" d="M 11 22H 19V 28H 11Z M 37 22H 45V 28H 37Z" />
          </g>
          <g class="warehouse-icon" transform="translate(296 82)">
            <path class="warehouse-roof" d="M 0 10 28 0 56 10V 15H 0Z" />
            <path class="warehouse-wall" d="M 4 15H 52V 34H 4Z" />
            <path class="warehouse-door" d="M 20 20H 36V 34H 20Z" />
            <path class="warehouse-window" d="M 8 20H 15V 27H 8Z M 41 20H 48V 27H 41Z" />
          </g>
          <g class="parcel-motion">
            <animateMotion
              dur="8s"
              repeatCount="indefinite"
              path="M 322 102 Q 180 8 38 102"
            />
            <animate
              attributeName="opacity"
              values="0;1;1;0"
              keyTimes="0;0.12;0.86;1"
              dur="8s"
              repeatCount="indefinite"
            />
            <g transform="translate(-14 -12)">
              <path class="parcel-box" d="M 0 5 14 0 28 5 14 11Z" />
              <path class="parcel-box-side" d="M 0 5 14 11V 24L 0 18Z" />
              <path class="parcel-box-front" d="M 14 11 28 5V 18L 14 24Z" />
              <path class="parcel-tape" d="M 12 1 17 3 12 6V 19L 9 18V 5Z" />
            </g>
          </g>
          <g class="static-parcel" transform="translate(180 56)">
            <path class="parcel-box" d="M 0 5 14 0 28 5 14 11Z" />
            <path class="parcel-box-side" d="M 0 5 14 11V 24L 0 18Z" />
            <path class="parcel-box-front" d="M 14 11 28 5V 18L 14 24Z" />
            <path class="parcel-tape" d="M 12 1 17 3 12 6V 19L 9 18V 5Z" />
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<section class="stats">
  <div class="container stats-grid">
    <% stats.forEach((stat) => { %>
      <div class="stat-box">
        <strong><%= stat.value %></strong>
        <span><%= stat.label %></span>
      </div>
    <% }) %>
  </div>
</section>

<section class="section-gap" id="services">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Our services</p>
      <h2>Logistics solutions built for speed.</h2>
    </div>

    <div class="service-grid">
      <article class="service-card">
        <div class="icon-box">01</div>
        <h3>Express delivery</h3>
        <p>Priority shipping with real-time tracking and optimized delivery times for urgent needs.</p>
      </article>
      <article class="service-card">
        <div class="icon-box">02</div>
        <h3>International shipping</h3>
        <p>Reliable global coverage to move your goods wherever they need to go.</p>
      </article>
      <article class="service-card">
        <div class="icon-box">03</div>
        <h3>B2B &amp; e-commerce</h3>
        <p>Order management, recurring shipments and centralized control for growing businesses.</p>
      </article>
    </div>

    <div class="hero-visual services-visual">
      <div class="transport-gallery" role="region" aria-roledescription="carousel" aria-label="Our delivery methods" tabindex="0">
        <div class="transport-track">
          <figure class="transport-card">
            <img src="/images/parcel-photo.jpg" alt="Packages moving through a shipping warehouse" />
            <figcaption>Parcels</figcaption>
          </figure>
          <figure class="transport-card">
            <img src="/images/aircraft-photo.jpg" alt="Cathay Pacific cargo airplane at the airport" />
            <figcaption>Air freight</figcaption>
          </figure>
          <figure class="transport-card">
            <img src="/images/cargo-ship-photo.jpg" alt="Container ship carrying freight at port" />
            <figcaption>Sea freight</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-gap value-panel">
  <div class="container two-columns">
    <div>
      <p class="eyebrow">Why QuickDeveleryInc</p>
      <h2>A delivery platform designed for performance.</h2>
      <ul class="feature-list">
        <li>Real-time shipment tracking</li>
        <li>Complete shipment history and management</li>
        <li>Centralized status administration</li>
        <li>A modern, intuitive customer experience</li>
      </ul>
    </div>

    <div class="value-cards">
      <div class="mini-panel">
        <strong>99.2%</strong>
        <span>On-time deliveries</span>
      </div>
      <div class="mini-panel">
        <strong>220</strong>
        <span>Countries connected</span>
      </div>
      <div class="mini-panel accent">
        <strong>24/7</strong>
        <span>Support and operations</span>
      </div>
    </div>
  </div>
</section>

<section class="section-gap demo-panel">
  <div class="container two-columns">
    <div>
      <p class="eyebrow">Customer account</p>
      <h2>Manage your shipments with ease.</h2>
      <ul class="feature-list">
        <li>Create a shipment in just a few clicks</li>
        <li>Track your package in real time</li>
        <li>Review your complete shipment history</li>
      </ul>
    </div>
    <div>
      <p class="eyebrow">Administrator account</p>
      <h2>Oversee your logistics operations.</h2>
      <ul class="feature-list">
        <li>View every shipment</li>
        <li>Update delivery statuses</li>
        <li>Monitor activity in real time</li>
      </ul>
    </div>
  </div>
</section>

<section class="section-gap process-panel">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">How it works</p>
      <h2>A smooth journey from booking to delivery.</h2>
    </div>

    <div class="process-grid">
      <article class="process-card">
        <span>01</span>
        <h3>Create your account</h3>
        <p>Set up your profile in seconds and access your customer dashboard.</p>
      </article>
      <article class="process-card">
        <span>02</span>
        <h3>Book your shipment</h3>
        <p>Enter the origin, destination and shipment type in just a few steps.</p>
      </article>
      <article class="process-card">
        <span>03</span>
        <h3>Follow every step</h3>
        <p>Get clear updates and track your package all the way to its final destination.</p>
      </article>
    </div>
  </div>
</section>

<section class="section-gap testimonials-panel" id="testimonials">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Trusted by our customers</p>
      <h2>What our customers say.</h2>
    </div>

    <div class="testimonial-grid">
      <% testimonials.forEach((testimonial) => { %>
        <article class="testimonial-card">
          <div class="testimonial-rating" aria-label="<%= testimonial.rating %> stars out of 5">
            <% for (let i = 0; i < testimonial.rating; i += 1) { %>
              <span aria-hidden="true">★</span>
            <% } %>
          </div>
          <blockquote><%= testimonial.quote %></blockquote>
          <div class="testimonial-author">
            <span class="author-avatar"><%= testimonial.name.charAt(0) %></span>
            <div>
              <strong><%= testimonial.name %></strong>
              <small><%= testimonial.role %></small>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
